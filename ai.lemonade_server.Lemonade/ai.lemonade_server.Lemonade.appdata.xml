<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>ai.lemonade_server.Lemonade</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>Apache-2.0</project_license>
  <name>Lemonade</name>
  <summary>Local LLM Server and Desktop Application</summary>
  <developer id="ai.lemonade_server">
    <name>Lemonade SDK</name>
  </developer>
  <description>
    <p>
      Lemonade runs large language models on your own machine. It bundles a local
      LLM server with a desktop chat client and a system-tray control.
    </p>
    <ul>
      <li>llama.cpp, FastFlowLM, and RyzenAI inference backends</li>
      <li>Desktop chat interface and model manager</li>
      <li>Built-in HTTP API server, managed from the system tray</li>
    </ul>
  </description>
  <launchable type="desktop-id">ai.lemonade_server.Lemonade.desktop</launchable>
  <screenshots>
    <screenshot type="default">
      <caption>Lemonade Banner</caption>
